#################################################
# Address Geocoding - Environment Configuration
# Copy this file to .env and fill in real values
# NEVER commit .env to git!
#################################################

# ============================================
# Snowflake Data Warehouse Credentials (Key Pair Auth)
# ============================================
SNOWFLAKE_USER=your_username_here
SNOWFLAKE_PRIVATE_KEY_B64=your_base64_encoded_private_key_here
# Optional: passphrase if the private key is encrypted
# SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=your_passphrase_here
SNOWFLAKE_ACCOUNT=dv56305.west-us-2.azure
SNOWFLAKE_WAREHOUSE=dataloadingonly
SNOWFLAKE_DATABASE=MPS_Warehouse
SNOWFLAKE_SCHEMA=datalake

# ============================================
# Infinite Campus Database Credentials (SQL Server)
# ============================================
IC_DB_USER=your_username_here
IC_DB_PASSWORD=your_password_here
IC_DB_SERVER=icampus.mapleton.us,7771
IC_DB_DATABASE=mapleton
IC_DB_DRIVER=ODBC Driver 18 for SQL Server

# ============================================
# Geocodio API
# ============================================
GEOCODIO_API_KEY=your_api_key_here
GEOCODIO_API_VERSION=v2.1

# ============================================
# Application Settings
# ============================================
# Number of addresses to process per run
BATCH_SIZE=500

# Minimum accuracy to update IC database (0.0 to 1.0)
ACCURACY_THRESHOLD=0.8


# ── app_logger 2.1 notifications (optional) ───────────────────────────────────
# Notifications fire at finish() time when status==FAILED or any line >= LEVEL.
# Local NDJSON files remain the durable record; channels are best-effort.

# Minimum level that triggers a notification: WARNING (default) or ERROR.
NOTIFICATION_LEVEL=WARNING

# Optional: when set, notifications include a "View run" link to this URL.
# NOTIFICATION_DASHBOARD_URL=https://logs.example.com

# Email channel (entire channel skipped if EMAIL_ENABLED is unset/false)
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_SMTP_HOST=smtp.office365.com
NOTIFICATION_EMAIL_SMTP_PORT=587
NOTIFICATION_EMAIL_SMTP_USE_TLS=true
NOTIFICATION_EMAIL_FROM=etl-alerts@example.com
NOTIFICATION_EMAIL_TO=admin@example.com,team@example.com
# NOTIFICATION_EMAIL_USERNAME=  # optional, defaults to FROM
NOTIFICATION_EMAIL_PASSWORD=your_smtp_password

# Microsoft Teams channel (URL must be HTTPS)
NOTIFICATION_TEAMS_ENABLED=false
NOTIFICATION_TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-id
